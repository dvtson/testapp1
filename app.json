{
  "expo": {
    "name": "rlos-demo",
    "slug": "rlos-demo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.app.tests.1",
      "buildNumber": "2",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Ứng dụng cần quyền camera để quét QR CCCD và chụp ảnh khuôn mặt.",
        "NSPhotoLibraryUsageDescription": "Ứng dụng cần truy cập thư viện ảnh/tài liệu để tải lên bảng lương hoặc sao kê tài khoản."
      }
    },
    "android": {
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Ứng dụng cần quyền camera để quét QR CCCD và chụp ảnh khuôn mặt."
        }
      ],
      "expo-font"
    ]
  }
}
